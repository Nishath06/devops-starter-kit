###############################################################################
# DevOps Starter Kit — Bootstrap Configuration (.env)
# Used by bootstrap/install.sh and bootstrap/uninstall.sh
###############################################################################

# ==============================================================================
# EKS CLUSTER CONFIGURATION
# ==============================================================================
CLUSTER_NAME=devops-starter-kit
AWS_REGION=ap-south-1
EFS_ENABLED=true

# ==============================================================================
# GRAFANA CONFIGURATION
# ==============================================================================
GRAFANA_ADMIN_PASSWORD=Admin@12345

# ==============================================================================
# ARGOCD CONFIGURATION (Optional)
# ==============================================================================
ARGOCD_CHART_VERSION=7.4.4

# ==============================================================================
# MONITORING STACK (Optional Chart Overrides)
# ==============================================================================
PROMETHEUS_CHART_VERSION=62.3.1
METRICS_SERVER_CHART_VERSION=3.12.1

# ==============================================================================
# AWS CONTROLLERS & CSI DRIVER CHART VERSIONS
# ==============================================================================
AWS_LBC_CHART_VERSION=1.8.1
EXTERNAL_SECRETS_CHART_VERSION=0.10.0
EBS_CSI_CHART_VERSION=2.33.0
EFS_CSI_CHART_VERSION=3.0.7
SECRETS_STORE_CSI_CHART_VERSION=1.4.7
AWS_PROVIDER_CHART_VERSION=0.3.9

# ==============================================================================
# IRSA IAM ROLE ARNs (Replace with Terraform Outputs)
# ==============================================================================

# AWS Load Balancer Controller
LBC_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/devops-starter-kit-aws-load-balancer-controller-role

# AWS EBS CSI Driver
EBS_CSI_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/devops-starter-kit-ebs-csi-role

# AWS EFS CSI Driver
EFS_CSI_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/devops-starter-kit-efs-csi-role

# External Secrets Operator
ESO_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/devops-starter-kit-external-secrets-role

# Secrets Store CSI Driver (AWS Provider)
SECRETS_CSI_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/devops-starter-kit-secrets-store-csi-role

# ==============================================================================
# OPTIONAL FLAGS
# ==============================================================================

# Print commands without executing them.
DRY_RUN=false